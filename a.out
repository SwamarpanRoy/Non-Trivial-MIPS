    %store/vec4 v0x103374c70_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x103378c60_0, 0, 1;
    %end;
    .thread T_0, $init;
    .scope S_0x1033787b0;
T_1 ;
    %delay 5, 0;
    %load/vec4 v0x103374c70_0;
    %inv;
    %store/vec4 v0x103374c70_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1033787b0;
T_2 ;
    %delay 10, 0;
    %load/vec4 v0x103378c60_0;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_2.0, 4;
    %jmp T_2.1;
T_2.0 ;
    %vpi_call/w 3 8 "$error", "assertion failed" {0 0 0};
T_2.1 ;
