#! /opt/homebrew/Cellar/icarus-verilog/12.0/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/v2009.vpi";
S_0x1051bec50 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x1051bf690 .scope module, "apb_subsystem_tb" "apb_subsystem_tb" 3 2;
 .timescale 0 0;
v0x1051bc4f0_0 .var "clk", 0 0;
v0x1051bf930_0 .var "rst_n", 0 0;
    .scope S_0x1051bf690;
T_0 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1051bc4f0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x1051bf930_0, 0, 1;
    %end;
    .thread T_0, $init;
    .scope S_0x1051bf690;
T_1 ;
    %delay 5, 0;
    %load/vec4 v0x1051bc4f0_0;
    %inv;
    %store/vec4 v0x1051bc4f0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x1051bf690;
T_2 ;
    %vpi_call/w 3 8 "$display", "TIME 0: STARTED TB" {0 0 0};
    %delay 40, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x1051bf930_0, 0, 1;
    %vpi_call/w 3 11 "$display", "TIME 40: RESET RELEASED" {0 0 0};
    %delay 100, 0;
    %vpi_call/w 3 13 "$display", "TIME 140: FINISHED" {0 0 0};
    %vpi_call/w 3 14 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "tb_simple.sv";
